# Telegram MTProto application credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=telegram-intelligence

# Destination for private notifications/digests
TELEGRAM_SAVED_MESSAGES=true

# Optional LLM structuring
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional read-only X metrics collector
X_COLLECTOR_URL=http://127.0.0.1:8765
X_COLLECTOR_TOKEN=replace-with-a-long-random-token


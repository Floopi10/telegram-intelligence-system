# Вакансии reply guy / гострайтер для знакомого.
# Допиши эти строки в конец ~/telegram-offer-parser/.env на сервере и перезапусти сервис:
#   sudo systemctl restart telegram-offer-parser

# Токен бота из @BotFather (знакомый должен один раз нажать Start в этом боте).
GIG_BOT_TOKEN=ВСТАВЬ_ТОКЕН

# chat id знакомого. Узнать после деплоя:
#   cd ~/telegram-offer-parser && .venv/bin/python -m offer_parser.gig_pipeline
# Пока строка пустая, поток выключен. Несколько читателей — через запятую: bot:111,bot:222
GIG_NOTIFY_TARGET=

# Сколько вакансий слать в день и насколько старые посты пропускать.
GIG_NOTIFY_LIMIT=30
GIG_MAX_AGE_DAYS=14

# Поиск по X через коллектор. Включай (1) только после того, как на x-browser-vm
# появится x_search.py и маршрут /search в x_service.py.
GIG_X_SEARCH=0
GIG_X_INTERVAL_MIN=180

TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=replace_with_your_api_hash

# Telegram username, chat ID, or "me" for Saved Messages.
NOTIFY_TARGET=me

# Offers with this score or higher are saved and reported.
MIN_SCORE=5

# Relative paths are resolved from this project directory.
SESSION_PATH=data/account
DATABASE_PATH=data/offers.db
CHATS_FILE=data/chats.csv
RULES_FILE=rules.json

# Optional proxy. Supported values: http, socks5, socks4.
# PROXY_TYPE=http
# PROXY_HOST=127.0.0.1
# PROXY_PORT=10809
# PROXY_USERNAME=
# PROXY_PASSWORD=

# Knowledge pipeline. It reuses the same Telethon client and session.
KNOWLEDGE_ENABLED=0
KNOWLEDGE_TARGET=me
KNOWLEDGE_MIN_SCORE=4
KNOWLEDGE_DATABASE_PATH=data/knowledge.db
KNOWLEDGE_CHATS_FILE=data/knowledge_chats.csv
KNOWLEDGE_RULES_FILE=knowledge_rules.json
KNOWLEDGE_EXCLUSIONS_FILE=data/knowledge_exclusions.csv

# Priority X/Twitter sources and read-only enrichment.
TWITTER_PRIORITY_FILE=twitter_priority_sources.json
TWITTER_AI_ENABLED=0
TWITTER_AI_ENV_FILE=.env
TWITTER_STRENGTH_ENABLED=0
X_COLLECTOR_ENV_FILE=.env
TWITTER_DAILY_LIMIT=30
TWITTER_MECHANICS_DAILY_LIMIT=10

# Balanced knowledge stream and daily digest.
KNOWLEDGE_BALANCE_ENABLED=1
KNOWLEDGE_DAILY_LIMIT=15
DAILY_DIGEST_ENABLED=1
DAILY_DIGEST_TARGET=me
DAILY_DIGEST_HOUR_MSK=21
